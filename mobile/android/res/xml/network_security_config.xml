<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext is allowed to loopback and nowhere else. The server this app talks
  to is its own child process on 127.0.0.1, which is where the traffic begins
  and ends; opening cleartext for the whole app would permit something this
  app never does.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
