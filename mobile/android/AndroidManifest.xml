<?xml version="1.0" encoding="utf-8"?>
<!--
  The app is the server with a WebView in front of it.

  Nothing here is a port of the emulator: the same Go binary a desktop runs is
  bundled as a native library, started on loopback, and drawn by the same page
  a desktop browser loads. What that buys is the whole of what this project
  spent a day failing to buy over a network — `http://127.0.0.1` is a secure
  context, so the page is installable and its service worker registers, and
  there is no address to find, no key to carry and no router to configure.

  INTERNET is for the WebView to reach loopback. Nothing here talks to the
  network, and the server is told to bind 127.0.0.1 so nothing on the Wi-Fi
  can reach it either.

  configChanges lists what the activity takes without being rebuilt: a split
  screen or pop-up view (smallestScreenSize), a keyboard or a controller
  attached (keyboard, navigation) and a display size change (density) among
  them. The web view adapts to each, and a rebuild would load the page again in
  the middle of a game. What is not listed still rebuilds the activity, which
  keeps the server running for the next one; see MainActivity.onDestroy.

  VIBRATE is for the page's `navigator.vibrate`, which a game's vibration
  becomes. The WebView answers the call either way, but without this it never
  reaches the motor, so the 📳 진동 switch was offered and did nothing. A
  controller's motor does not need it.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.movingwoo.wfeature">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:hardwareAccelerated="true"
        android:extractNativeLibs="true"
        android:supportsRtl="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|smallestScreenSize|screenLayout|density|uiMode"
            android:theme="@android:style/Theme.Black.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
